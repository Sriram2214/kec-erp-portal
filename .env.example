# KCE ERP Environment Configuration

# Security
SECRET_KEY=kce-erp-production-secret-key-replace-me

# Database
# For SQLite: sqlite:///app.db
# For PostgreSQL: postgresql://user:pass@localhost/dbname
DATABASE_URL=sqlite:///app.db

# Flask Settings
FLASK_APP=wsgi.py
FLASK_ENV=production

# Server Settings
PORT=5000
THREADS=32
